DB_HOST=mysql
DB_PORT=3306
DB_NAME=mystock
DB_USER=
DB_PASSWORD=

REDIS_HOST=local-redis
REDIS_PORT=6379
REDIS_PASSWORD=
# optional: TTL of cached products and lists (default 10 min)
CACHE_TTL_SECONDS=600

# debug, info, notice, warning, error...
LOG_LEVEL=info

# HS256 key, at least 32 bytes: openssl rand -base64 48
JWT_SECRET_KEY=
